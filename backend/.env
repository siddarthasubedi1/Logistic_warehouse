# NODE_ENV=development
# PORT=5000
# MONGO_URI=mongodb://127.0.0.1:27017/logistic_warehouse
# CLIENT_URL=http://localhost:5173
# # Generate two different random secrets. Never use these placeholders in production.
# JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
# JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
# ACCESS_TOKEN_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_IN=7d
# # Set 1 only behind a single trusted reverse proxy; default is no trusted proxy.
# TRUST_PROXY=0
# # Disable automatic demo content in production unless explicitly required.
# SEED_STARTER_CONTENT=false
# # Set these privately only when bootstrapping the first Admin, then remove them.
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/logistic_warehouse
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=your-long-random-secret
JWT_REFRESH_SECRET=another-different-long-random-secret

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
TRUST_PROXY=0
SEED_STARTER_CONTENT=false

# Certificate email delivery (fill these in before using Admin > Certificates)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CERTIFICATE_FROM_NAME=UK LogiWare Safety Training
CERTIFICATE_FROM_EMAIL=
CERTIFICATE_MODULE_KEYS=manual-handling,working-at-height,cyber-awareness
