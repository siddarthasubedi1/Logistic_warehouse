# UK LOGIWARE SAFETY TRAINING

# SERVER CONFIGURATION
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MONGODB DATABASE
MONGO_URI=mongodb://127.0.0.1:27017/logistic_warehouse

# JWT AUTHENTICATION
JWT_ACCESS_SECRET=PASTE_YOUR_EXISTING_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=PASTE_YOUR_EXISTING_REFRESH_SECRET_HERE

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# SECURITY
TRUST_PROXY=0

# STARTER CONTENT
SEED_STARTER_CONTENT=false

# ADMIN BOOTSTRAP
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# CERTIFICATE MODULES
CERTIFICATE_MODULE_KEYS=manual-handling,working-at-height,cyber-awareness
# For certificate PDF links on other devices, set to a PUBLIC HTTPS backend URL.
# Example: PUBLIC_API_URL=https://api.your-domain.com
# Leave empty for testing links on this computer only.
PUBLIC_API_URL=
